<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Kovecses.Requests</AssemblyName>
    <RootNamespace>Kovecses.Requests</RootNamespace>
    <Version>1.2.0</Version>
    <Authors>Peter Kovecses</Authors>
    <Description>High-performance, "no-magic" light request handling implementation for .NET. Features a stateless pipeline, fluent registration, and direct handler injection for transparent debugging.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/peterkovecses/Requests</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peterkovecses/Requests</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>request-handling;mediator;pipeline;behaviors;dotnet;performance;clean-architecture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kovecses.Requests.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
