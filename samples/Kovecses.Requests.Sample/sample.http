@hostname = localhost
@port = 5000
@host = http://{{hostname}}:{{port}}

### Get Books
GET {{host}}/books
Accept: application/json

### Create Book
POST {{host}}/books
Content-Type: application/json

{
    "title": "The Hobbit",
    "author": "J.R.R. Tolkien",
    "price": 20.00
}

### Create Book (Validation Error)
POST {{host}}/books
Content-Type: application/json

{
    "title": "",
    "author": "J.R.R. Tolkien",
    "price": 0
}

### Update Book Price (Validation Error)
PATCH {{host}}/books/00000000-0000-0000-0000-000000000000/price
Content-Type: application/json

{
    "newPrice": -5.00
}
